{
  "name": "frontend",
  "version": "0.0.0",
  "scripts": {
    "ng": "npx -y -p node@24.15.0 node ./node_modules/@angular/cli/bin/ng",
    "start": "npx -y -p node@24.15.0 node ./node_modules/@angular/cli/bin/ng serve --proxy-config proxy.conf.json",
    "build": "npx -y -p node@24.15.0 node ./node_modules/@angular/cli/bin/ng build",
    "watch": "npx -y -p node@24.15.0 node ./node_modules/@angular/cli/bin/ng build --watch --configuration development",
    "test": "npm run build"
  },
  "private": true,
  "packageManager": "npm@11.11.0",
  "dependencies": {
    "@angular/common": "^22.0.0",
    "@angular/compiler": "^22.0.0",
    "@angular/core": "^22.0.0",
    "@angular/forms": "^22.0.0",
    "@angular/platform-browser": "^22.0.0",
    "@angular/router": "^22.0.0",
    "rxjs": "~7.8.0",
    "tslib": "^2.3.0"
  },
  "devDependencies": {
    "@angular/build": "^22.0.1",
    "@angular/cli": "^22.0.1",
    "@angular/compiler-cli": "^22.0.0",
    "prettier": "^3.8.1",
    "typescript": "~6.0.2"
  }
}
