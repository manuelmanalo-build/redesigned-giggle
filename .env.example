# Local container demo defaults. Copy to .env for local overrides.

BACKEND_PORT=8080

SPRING_DATASOURCE_USERNAME=trade_user
SPRING_DATASOURCE_PASSWORD=trade_password

SPRING_ARTEMIS_USER=artemis
SPRING_ARTEMIS_PASSWORD=artemis

TRADE_ORDER_SUBMITTED_QUEUE=order.submitted
TRADE_OUTBOX_RELAY_INTERVAL_MS=1000
TRADE_OUTBOX_BATCH_SIZE=25
TRADE_OUTBOX_MAX_ATTEMPTS=5

SPRING_JMS_LISTENER_CONCURRENCY=1
SPRING_JMS_LISTENER_MAX_CONCURRENCY=4

APP_LOG_LEVEL=INFO
JAVA_OPTS=-XX:InitialRAMPercentage=50 -XX:MaxRAMPercentage=75 -XX:+UseG1GC
